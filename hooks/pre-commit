#!/usr/bin/env python3
"""Pre-commit hook: blocks commits that contain secrets or violate coding conventions."""

import re
import subprocess
import sys
from pathlib import Path

# Patterns that indicate accidental secret commits
SECRET_PATTERNS = [
    re.compile(r'(?i)(password|passwd|secret|api_key|apikey|token|private_key)\s*=\s*["\'][^"\']{6,}["\']'),
    re.compile(r'(?i)bearer\s+[a-zA-Z0-9\-_\.]{20,}'),
    re.compile(r'(?i)ghp_[a-zA-Z0-9]{36}'),          # GitHub PAT
    re.compile(r'(?i)xoxb-[a-zA-Z0-9\-]{50,}'),      # Slack bot token
    re.compile(r'AKIA[0-9A-Z]{16}'),                   # AWS access key
]

BLOCKED_PATTERNS = [
    (re.compile(r'^\s*except\s*:\s*$', re.MULTILINE), "bare except: clause"),
    (re.compile(r'\beval\s*\('), "eval() call"),
    (re.compile(r'\bexec\s*\('), "exec() call"),
]


def get_staged_diff() -> str:
    result = subprocess.run(
        ["git", "diff", "--cached", "--unified=0"],
        capture_output=True, text=True
    )
    return result.stdout


def check_for_secrets(diff: str) -> list[str]:
    findings = []
    for i, line in enumerate(diff.splitlines(), 1):
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for pattern in SECRET_PATTERNS:
            if pattern.search(line):
                findings.append(f"  Line {i}: possible secret detected → {line.strip()[:80]}")
    return findings


def check_for_blocked_patterns(diff: str) -> list[str]:
    findings = []
    for i, line in enumerate(diff.splitlines(), 1):
        if not line.startswith("+") or line.startswith("+++"):
            continue
        for pattern, label in BLOCKED_PATTERNS:
            if pattern.search(line):
                findings.append(f"  Line {i}: {label} → {line.strip()[:80]}")
    return findings


def main() -> int:
    diff = get_staged_diff()
    secret_issues = check_for_secrets(diff)
    code_issues = check_for_blocked_patterns(diff)
    all_issues = secret_issues + code_issues

    if all_issues:
        print("❌ Pre-commit hook FAILED:")
        for issue in all_issues:
            print(issue)
        print("\nFix the issues above and try again.")
        return 1

    print("✅ Pre-commit checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
